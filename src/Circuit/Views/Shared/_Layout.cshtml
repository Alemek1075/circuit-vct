<!doctype html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#111215" />
    <meta name="description" content="@(ViewData["Description"] ?? "Circuit: неофіційні турнірні сітки й результати VALORANT Champions українською.")" />
    <meta name="robots" content="@(Context.Request.Path.StartsWithSegments("/studio") ? "noindex,nofollow" : ViewData["Robots"] ?? "index,follow")" />
    @if (ViewData["CanonicalPath"] is string canonicalPath)
    {
        <link rel="canonical" href="@($"{Context.Request.Scheme}://{Context.Request.Host}{canonicalPath}")" />
    }
    <title>@ViewData["Title"] · Circuit</title>
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@ViewData["Title"] · Circuit" />
    <meta property="og:description" content="@(ViewData["Description"] ?? "Неофіційний архів турнірних сіток VALORANT Champions.")" />
    <link rel="icon" type="image/svg+xml" href="~/img/favicon.svg" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/refresh.css" asp-append-version="true" />
</head>
<body>
    @RenderBody()
    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
